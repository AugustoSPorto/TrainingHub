<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Prevents duplicate enrollments and enforces the 3-enrollment course limit on the admin form.</description>
        <field>user</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>Validate Duplicate Enrollment</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var userId = g_form.getValue('user');
    var scheduleId = g_form.getValue('schedule');

    if (!userId || !scheduleId) {
        return true;
    }

    // Check duplicate enrollment (STRY 7)
    var gaDuplicate = new GlideAjax('x_1960572_training.TrainingHubUtils');
    gaDuplicate.addParam('sysparm_name', 'checkDuplicateEnrollment');
    gaDuplicate.addParam('sysparm_user', userId);
    gaDuplicate.addParam('sysparm_schedule', scheduleId);
    gaDuplicate.getXMLAnswer(function(answerDuplicate) {
        if (answerDuplicate === 'true') {
			g_form.clearValue('schedule');
            g_form.showFieldMsg('schedule', 'Error: This user is already enrolled in this schedule!', 'error');
            return;
        }


    });

    return false;
}]]></script>
